# Copy these values into apps/api/.env. Do not place server secrets in apps/web or VITE_* variables.
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Replace with your own MongoDB Atlas URI. Keep credentials private.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
